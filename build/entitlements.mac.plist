<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Electron (V8) needs JIT -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>

    <!-- Required to load the native modules (.node) of noble / node-hid /
         serialport. Without it the hardened runtime's library validation
         rejects them and the app will not start. -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>

    <!-- The HDMI capture preview reads the capture device through getUserMedia.
         Without this the hardened runtime denies camera access outright and the
         TCC prompt never appears. -->
    <key>com.apple.security.device.camera</key>
    <true/>
</dict>
</plist>
